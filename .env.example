# DIKIDI login is entered on /setup, not here.
DIKIDI_BACKEND=mock
PUBLIC_BASE_URL=https://dkdialice.onrender.com
# Render: PostgreSQL Internal Database URL. Local development: sqlite:///connections.db
DATABASE_URL=
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep the same key across deployments. Back it up separately from the database.
CREDENTIALS_ENCRYPTION_KEY=

# Optional legacy environment-based connection. Not required for browser setup.
ALICE_OWNER_ID=
DIKIDI_PHONE=
DIKIDI_PASSWORD=
DIKIDI_COMPANY_ID=
DIKIDI_DEFAULT_STAFF_ID=
DIKIDI_TOKEN=
