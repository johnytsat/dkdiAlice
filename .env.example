# Какой бекенд Dikidi использовать:
#   mock — без реальной Dikidi (разработка и тесты)
#   sdk  — вход по телефону и паролю через пакет dikidi-api-client
#   http — официальный API (когда Dikidi выдаст партнёрский токен)
DIKIDI_BACKEND=mock

# --- для DIKIDI_BACKEND=sdk ---
# Телефон и пароль от аккаунта Dikidi Business (как при входе на сайт).
# Никогда не коммитьте заполненный .env — он в .gitignore.
DIKIDI_PHONE=
DIKIDI_PASSWORD=

# ID компании (филиала). Виден в адресной строке кабинета: ?company=1400000
DIKIDI_COMPANY_ID=

# ID мастера для новых записей. Пусто — взять первого из каталога.
DIKIDI_DEFAULT_STAFF_ID=

# --- для DIKIDI_BACKEND=http ---
DIKIDI_TOKEN=
