[Unit]
Description=Dikidi Alice Skill webhook
After=network.target

[Service]
Type=simple
User=dikidi-alice
WorkingDirectory=/opt/dikidi-alice-skill
EnvironmentFile=/opt/dikidi-alice-skill/.env
ExecStart=/opt/dikidi-alice-skill/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
